<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nvidia.cuvs</groupId>
  <artifactId>cuvs-bench-java-format</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <!-- Tooling only: these Java sources are packaged or compiled by the Python/PyLucene flows. -->
  <build>
    <directory>${project.basedir}/../../build/cuvs-bench-java-format</directory>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.44.5</version>
        <configuration>
          <java>
            <includes>
              <include>cuvs_bench/backends/_java/**/*.java</include>
              <include>tests/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>1.27.0</version>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
              <formatJavadoc>false</formatJavadoc>
            </googleJavaFormat>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
