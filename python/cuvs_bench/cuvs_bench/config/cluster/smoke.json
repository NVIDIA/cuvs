{
  "dataset": {
    "name": "test-data",
    "base_file": "test-data/ann_benchmarks_like.base.fbin",
    "dtype": "float"
  },
  "clustering": [
    {
      "name": "cuvs_kmeans.k16",
      "algo": "cuvs_kmeans",
      "param": {"n_clusters": 16, "max_iter": 20, "tol": 1e-4, "init": "kmeans++"}
    },
    {
      "name": "cuvs_kmeans_balanced.k16",
      "algo": "cuvs_kmeans_balanced",
      "param": {"n_clusters": 16, "n_iters": 20}
    }
  ]
}
