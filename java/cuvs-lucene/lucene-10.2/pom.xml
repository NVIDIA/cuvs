<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.nvidia.cuvs.lucene</groupId>
    <artifactId>cuvs-lucene-parent</artifactId>
    <!-- NOTE: The version automatically gets updated when ci/release/update-version.sh is invoked. -->
    <!--CUVS_JAVA#VERSION_UPDATE_MARKER_START--><version>26.12.0</version><!--CUVS_JAVA#VERSION_UPDATE_MARKER_END-->
  </parent>
  <artifactId>cuvs-lucene-10.2</artifactId>
  <name>cuvs-lucene-10.2</name>
  <packaging>jar</packaging>

  <description>
      Pluggable codecs for Apache Lucene 10.2.x that enable GPU-based accelerated vector search.
  </description>

  <properties>
    <lucene.version>10.2.0</lucene.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <!--
            Builds cuvs-lucene-10.2-<version>-jar-with-dependencies.jar: this module's classes together
            with its runtime dependencies (such as cuvs-java), with their META-INF/services files
            merged. It is configured in the parent's pluginManagement, but each module declares it
            itself: declared in the parent's plugins, it would also build a fat jar for the parent pom.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
