#include <core/cub_histogram_launchers.hpp>
#include <distance/top_1_nn.cuh>

#include <core/cub_histogram.hpp>
#include <core/cub_ptx_query.hpp>
#include <cub/device/device_histogram.cuh>
#include <cuda/iterator>
#include <cuvs/core/cuda_fp16.hpp>
#include <raft/util/cudart_utils.hpp>

namespace cuvs::detail {

template <typename SampleIt, typename CounterT, typename LevelT, typename NumItems>
cudaError_t histogram_even(void* storage,
                           size_t& bytes,
                           SampleIt samples,
                           CounterT* counts,
                           int levels,
                           LevelT lower,
                           LevelT upper,
                           NumItems count,
                           cudaStream_t stream)
{
  return cub::DeviceHistogram::HistogramEven(
    storage, bytes, samples, counts, levels, lower, upper, count, stream);
}

// clang-format off
template @return_type@ @qualified_function@@template_arguments@(@parameter_types@)@function_qualifiers@;
// clang-format on

}  // namespace cuvs::detail
