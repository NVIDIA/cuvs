#include <core/histogram.hpp>

#include <cstddef>
#include <cstdint>
#include <raft/stats/histogram.cuh>

namespace cuvs::detail {

template <typename DataT, typename IdxT>
void histogram(raft::stats::HistType type,
               int* bins,
               IdxT nbins,
               const DataT* data,
               IdxT nrows,
               IdxT ncols,
               cudaStream_t stream)
{
  raft::stats::histogram<DataT, IdxT>(type, bins, nbins, data, nrows, ncols, stream);
}

// clang-format off
template @return_type@ @qualified_function@@template_arguments@(@parameter_types@)@function_qualifiers@;
// clang-format on

}  // namespace cuvs::detail
