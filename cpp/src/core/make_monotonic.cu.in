                                                                  cudaStream_t);

namespace cuvs::detail {

template <typename Type, typename Lambda>
void make_monotonic(
  Type* out, Type* in, size_t N, cudaStream_t stream, Lambda filter_op, bool zero_based)

{
  return raft::label::make_monotonic(out, in, N, stream, filter_op, zero_based);
}

template <typename Type>
void make_monotonic(Type* out, Type* in, size_t N, cudaStream_t stream, bool zero_based)

{
  return raft::label::make_monotonic(out, in, N, stream, zero_based);
}

}  // namespace cuvs::detail

