extern template int raft::label::detail::getUniquelabels<int>(rmm::device_uvector<int>&,
                                                              int*,
                                                              size_t,
                                                              cudaStream_t);
extern template int raft::label::detail::getUniquelabels<uint32_t>(rmm::device_uvector<uint32_t>&,
                                                                   uint32_t*,
                                                                   size_t,
                                                                   cudaStream_t);
extern template int raft::label::detail::getUniquelabels<int64_t>(rmm::device_uvector<int64_t>&,
                                                                  int64_t*,
