#include <core/cub_reduce_launchers.hpp>

#include <core/cub_ptx_query.hpp>
#include <core/cub_scalar_reduction_launchers.hpp>
#include <cuvs/core/cuda_fp16.hpp>
#include <rmm/exec_policy.hpp>
#include <thrust/reduce.h>

namespace cuvs::detail {

template <typename Policy, typename Iterator>
typename std::iterator_traits<Iterator>::value_type thrust_reduce(Policy const& policy,
                                                                  Iterator first,
                                                                  Iterator last)
{
  return thrust::reduce(policy, first, last);
}

template <typename Policy, typename Iterator, typename Value>
Value thrust_reduce(Policy const& policy, Iterator first, Iterator last, Value init)
{
  return thrust::reduce(policy, first, last, init);
}

template <typename Policy, typename Iterator, typename Value, typename Op>
Value thrust_reduce(Policy const& policy, Iterator first, Iterator last, Value init, Op op)
{
  return thrust::reduce(policy, first, last, init, op);
}

}  // namespace cuvs::detail

// clang-format off
template @return_type@ @qualified_function@@template_arguments@(@parameter_types@)@function_qualifiers@;
// clang-format on
