#include <core/cub_ptx_query.hpp>

#include <core/cub_scan_launchers.hpp>

#include <core/spectral_launchers.hpp>

#include <cuvs/core/cuda_fp16.hpp>
#include <raft/util/cuda_utils.cuh>
#include <raft/util/device_atomics.cuh>

#include <raft/sparse/linalg/symmetrize.cuh>

extern template void raft::sparse::op::detail::compute_duplicates_mask<int, unsigned long>(
  int*, int const*, int const*, unsigned long, cudaStream_t);

extern template void raft::sparse::op::detail::compute_duplicates_mask<long, unsigned long>(
  long*, long const*, long const*, unsigned long, cudaStream_t);

extern template void raft::sparse::op::detail::coo_sort<float, int, int>(
  bool, int, int, int, int*, int*, float*, cudaStream_t);

extern template void raft::sparse::op::detail::coo_sort<float, int, long>(
  bool, int, int, long, int*, int*, float*, cudaStream_t);

extern template void raft::sparse::op::detail::coo_sort<double, int, int>(
  bool, int, int, int, int*, int*, double*, cudaStream_t);

extern template void raft::sparse::op::detail::coo_sort<double, int, long>(
  bool, int, int, long, int*, int*, double*, cudaStream_t);

extern template void raft::sparse::op::detail::coo_sort<float, int, unsigned long>(
  bool, int, int, unsigned long, int*, int*, float*, cudaStream_t);

extern template void raft::sparse::op::detail::coo_sort<float, long, unsigned long>(
  bool, long, long, unsigned long, long*, long*, float*, cudaStream_t);

namespace cuvs::detail {

template <typename value_idx, typename value_t, typename nnz_t>
void symmetrize(raft::resources const& handle,
                const value_idx* rows,
                const value_idx* cols,
                const value_t* vals,
                value_idx m,
                value_idx n,
                nnz_t nnz,
                raft::sparse::COO<value_t, value_idx, nnz_t>& out)

{
  return raft::sparse::linalg::symmetrize(handle, rows, cols, vals, m, n, nnz, out);
}

}  // namespace cuvs::detail

// clang-format off
template @return_type@ @qualified_function@@template_arguments@(@parameter_types@)@function_qualifiers@;
// clang-format on
