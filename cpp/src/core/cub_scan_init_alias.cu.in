#include <core/cub_ptx_query.hpp>

#include <core/cub_scan_launchers.hpp>

namespace {

using inst_pointer_t            = @pointer_type@;
using inst_provider_t           = @provider@;
using inst_canonical_provider_t = @canonical_provider@;

}  // namespace

// clang-format off
template <>
__host__ __device__ inst_pointer_t inst_provider_t ::@method@()
// clang-format on
{
  return inst_canonical_provider_t ::@method@();
}
