#include <core/cub_ptx_query.hpp>
#include <core/random_launchers.hpp>
#include <raft/random/rng.cuh>

namespace cuvs::detail::random {

template <typename T, typename Weight, typename Index>
void discrete(raft::resources const& res,
              raft::random::RngState& state,
              raft::device_vector_view<T, Index> out,
              raft::device_vector_view<const Weight, Index> weights)
{
  raft::random::discrete(res, state, out, weights);
}

}  // namespace cuvs::detail::random

// clang-format off
@random_rng_extern_instantiations@

template @return_type@ @qualified_function@@template_arguments@(@parameter_types@)@function_qualifiers@;
// clang-format on
