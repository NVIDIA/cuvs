  raft::linalg::detail::ReductionThinPolicy<32, 128, 1, false>,
  float,
  float,
  int,
  raft::identity_op,
  raft::add_op,
  raft::identity_op>(float*,
                     float const*,
                     int,
                     int,
                     float,
                     CUstream_st*,
                     bool,
                     raft::identity_op,
                     raft::add_op,
                     raft::identity_op);

