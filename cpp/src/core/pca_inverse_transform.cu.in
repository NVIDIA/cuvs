#include <raft/linalg/pca.cuh>
#include <raft/linalg/strided_reduction.cuh>

extern template void
raft::matrix::detail::matrixVectorBinaryMultSkipZero<true, false, float, long, 256>(
  float*, float const*, long, long, cudaStream_t);

extern template void
raft::matrix::detail::matrixLinewiseVecCols<float, long, 8ul, 256, raft::add_op, float>(
  float*, float const*, long, long, raft::add_op, CUstream_st*, float const*);

extern template void
raft::matrix::detail::matrixLinewiseVecCols<float, long, 4ul, 256, raft::add_op, float>(
  float*, float const*, long, long, raft::add_op, CUstream_st*, float const*);

extern template void
raft::matrix::detail::matrixLinewiseVecCols<float, long, 16ul, 256, raft::add_op, float>(
  float*, float const*, long, long, raft::add_op, CUstream_st*, float const*);

extern template void
raft::matrix::detail::matrixLinewiseVecRows<float, long, 8ul, 256, raft::add_op, float>(
  float*, float const*, long, long, raft::add_op, CUstream_st*, float const*);

extern template void
raft::matrix::detail::matrixLinewiseVecRows<float, long, 4ul, 256, raft::add_op, float>(
  float*, float const*, long, long, raft::add_op, CUstream_st*, float const*);

extern template void
raft::matrix::detail::matrixLinewiseVecRows<float, long, 16ul, 256, raft::add_op, float>(
