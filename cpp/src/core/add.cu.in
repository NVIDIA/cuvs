#include <core/map_launchers.hpp>

#include <cuvs/core/cuda_fp16.hpp>
#include <raft/linalg/add.cuh>

extern template void raft::linalg::detail::
  map<false, unsigned int, unsigned int, raft::add_op, unsigned int, unsigned int>(
    cuda::stream_ref,
    unsigned int*,
    unsigned int,
    raft::add_op,
    unsigned int const*,
    unsigned int const*);

extern template void raft::linalg::detail::map<false, float, int, raft::add_op, float, float>(
  cuda::stream_ref, float*, int, raft::add_op, float const*, float const*);
extern template void raft::linalg::detail::map<false, double, int, raft::add_op, double, double>(
  cuda::stream_ref, double*, int, raft::add_op, double const*, double const*);

namespace cuvs::detail {

template <typename InT, typename OutT, typename IdxType>
void add(OutT* out, const InT* in1, const InT* in2, IdxType len, cudaStream_t stream)

{
  return raft::linalg::add(out, in1, in2, len, stream);
}

template <typename InType, typename OutType, typename, typename>
void add(raft::resources const& handle, InType in1, InType in2, OutType out)

{
  return raft::linalg::add(handle, in1, in2, out);
}

}  // namespace cuvs::detail

// clang-format off
template @return_type@ @qualified_function@@template_arguments@(@parameter_types@)@function_qualifiers@;
// clang-format on
