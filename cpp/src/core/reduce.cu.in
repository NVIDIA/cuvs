namespace cuvs::detail {

template <Apply apply,
          typename InElementType,
          typename LayoutPolicy,
          typename OutElementType,
          typename IdxType,
          typename MainLambda,
          typename ReduceLambda,
          typename FinalLambda>
void reduce(raft::resources const& handle,
            raft::device_matrix_view<const InElementType, IdxType, LayoutPolicy> data,
            raft::device_vector_view<OutElementType, IdxType> dots,
            OutElementType init,
            bool inplace,
            MainLambda main_op,
            ReduceLambda reduce_op,
            FinalLambda final_op)
{
  raft::linalg::reduce<apply>(handle, data, dots, init, inplace, main_op, reduce_op, final_op);
}

}  // namespace cuvs::detail

// clang-format off
@coalesced_dispatch_extern_instantiations@
@strided_dispatch_extern_instantiations@
@strided_launch_extern_instantiations@
