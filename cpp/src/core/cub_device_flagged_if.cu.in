#include <core/cub_ptx_query.hpp>

#include <core/cub_device_flagged_if_launchers.hpp>

namespace {

using inst_input_t     = @input_type@;
using inst_flags_t     = @flags_type@;
using inst_output_t    = @output_type@;
using inst_count_t     = @count_type@;
using inst_predicate_t = @predicate_type@;

}  // namespace

template <>
CUB_RUNTIME_FUNCTION cudaError_t
cub::DeviceSelect::FlaggedIf<inst_input_t,
                             inst_flags_t,
                             inst_output_t,
                             inst_count_t,
                             inst_predicate_t,
                             cudaStream_t>(void* storage,
                                           size_t& bytes,
                                           inst_input_t input,
                                           inst_flags_t flags,
                                           inst_output_t output,
                                           inst_count_t selected,
                                           cuda::std::int64_t items,
                                           inst_predicate_t predicate,
                                           const cudaStream_t& environment)
{
  _CCCL_NVTX_RANGE_SCOPE_IF(storage, "cub::DeviceSelect::FlaggedIf");
  return cub::detail::dispatch_with_env_and_tuning<
    cub::detail::select::policy_selector_from_types<inst_input_t,
                                                    inst_flags_t,
                                                    inst_output_t,
                                                    cuda::std::int64_t,
                                                    cub::SelectImpl::Select>>(
    storage,
    bytes,
    environment,
    [&](auto selector, void* temporary, size_t& temporary_bytes, auto stream) {
      return cuvs::detail::cub_select_dispatch<cub::SelectImpl::Select>(temporary,
                                                                        temporary_bytes,
                                                                        input,
                                                                        flags,
                                                                        output,
                                                                        selected,
                                                                        predicate,
                                                                        cub::NullType{},
                                                                        items,
                                                                        stream,
                                                                        selector);
    });
}
