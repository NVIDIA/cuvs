#include <core/random_launchers.hpp>
#include <raft/random/permute.cuh>

namespace cuvs::detail::random {

template <typename Index>
void permute_indices(Index* indices, Index columns, Index rows, cudaStream_t stream)
{
  // Matrix values are not involved when only permutation indices are requested.
  raft::random::permute<float, Index, Index>(
    indices, nullptr, nullptr, columns, rows, true, stream);
}

// clang-format off
template @return_type@ @qualified_function@@template_arguments@(@parameter_types@)@function_qualifiers@;
// clang-format on

}  // namespace cuvs::detail::random
