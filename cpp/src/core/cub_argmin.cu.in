#include <core/cub_ptx_query.hpp>
#include <core/cub_reduce_launchers.hpp>

#include <core/cub_runtime_launchers.hpp>
#include <cub/device/device_reduce.cuh>

namespace cuvs::detail {

template <typename Input, typename Output, typename Count>
cudaError_t cub_argmin(
  void* storage, size_t& bytes, Input input, Output output, Count count, cudaStream_t stream)
{
  return cub::DeviceReduce::ArgMin(storage, bytes, input, output, count, stream);
}

}  // namespace cuvs::detail

