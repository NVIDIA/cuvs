extern template raft::device_coo_matrix<float, int, int, int>
raft::sparse::linalg::detail::compute_graph_laplacian<float, int, int, int>(
  raft::resources const&, raft::device_coo_matrix_view<float, int, int, int>);

extern template raft::device_coo_matrix<float, int, int, long>
raft::sparse::linalg::detail::compute_graph_laplacian<float, int, int, long>(
  raft::resources const&, raft::device_coo_matrix_view<float, int, int, long>);

extern template raft::device_coo_matrix<double, int, int, int>
raft::sparse::linalg::detail::compute_graph_laplacian<double, int, int, int>(
  raft::resources const&, raft::device_coo_matrix_view<double, int, int, int>);

extern template raft::device_coo_matrix<double, int, int, long>
raft::sparse::linalg::detail::compute_graph_laplacian<double, int, int, long>(
  raft::resources const&, raft::device_coo_matrix_view<double, int, int, long>);

namespace cuvs::detail {

template <typename ElementType, typename IndptrType, typename IndicesType, typename NZType>
raft::device_csr_matrix<std::remove_const_t<ElementType>,
                        std::remove_const_t<IndptrType>,
                        std::remove_const_t<IndicesType>,
                        std::remove_const_t<NZType>>
laplacian_normalized(
  raft::resources const& res,
  raft::device_csr_matrix_view<ElementType, IndptrType, IndicesType, NZType> input,
  raft::device_vector_view<ElementType, IndptrType> diagonal_out)

{
  return raft::sparse::linalg::laplacian_normalized(res, input, diagonal_out);
}

template <typename ElementType, typename RowType, typename ColType, typename NZType>
raft::device_coo_matrix<std::remove_const_t<ElementType>,
                        std::remove_const_t<RowType>,
                        std::remove_const_t<ColType>,
                        std::remove_const_t<NZType>>
laplacian_normalized(raft::resources const& res,
                     raft::device_coo_matrix_view<ElementType, RowType, ColType, NZType> input,
                     raft::device_vector_view<ElementType, RowType> diagonal_out)

{
  return raft::sparse::linalg::laplacian_normalized(res, input, diagonal_out);
}

}  // namespace cuvs::detail

