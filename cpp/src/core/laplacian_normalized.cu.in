  cuda::stream_ref, float*, long, raft::const_op<float>);

extern template void raft::sparse::op::detail::coo_sort<float, int, int>(
  bool, int, int, int, int*, int*, float*, cudaStream_t);

extern template void raft::sparse::op::detail::coo_sort<float, int, long>(
  bool, int, int, long, int*, int*, float*, cudaStream_t);

