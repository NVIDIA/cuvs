                                                            long const*,
                                                            long const*,
                                                            long,
                                                            float*,
                                                            raft::const_op<bool>,
                                                            raft::identity_op,
                                                            cudaStream_t);

extern template void raft::matrix::detail::
  gatherImpl<float*, int const*, int const*, raft::const_op<bool>, raft::identity_op, float*, int>(
    float*,
    int,
    int,
    int,
    int const*,
    int const*,
    int,
    float*,
    raft::const_op<bool>,
    raft::identity_op,
    cudaStream_t);

extern template void raft::matrix::detail::gatherImpl<double*,
