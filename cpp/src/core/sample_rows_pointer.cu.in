                                                      long const*,
                                                      long const*,
                                                      raft::const_op<bool>,
                                                      raft::identity_op,
                                                      __half*,
                                                      long>(__half*,
                                                            long,
                                                            long,
                                                            long,
                                                            long const*,
                                                            long const*,
                                                            long,
                                                            __half*,
                                                            raft::const_op<bool>,
                                                            raft::identity_op,
                                                            cudaStream_t);

extern template void raft::matrix::detail::gatherImpl<float*,
                                                      long const*,
