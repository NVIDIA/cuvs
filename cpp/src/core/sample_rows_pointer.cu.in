extern template auto raft::random::detail::excess_subsample<int, int>(
  raft::resources const&, raft::random::RngState&, int, int) -> raft::device_vector<int, int>;
extern template auto raft::random::detail::excess_subsample<int64_t, int64_t>(
  raft::resources const&, raft::random::RngState&, int64_t, int64_t)
  -> raft::device_vector<int64_t, int64_t>;

namespace cuvs::detail {

template <typename T, typename Index>
void sample_rows(raft::resources const& res,
                 raft::random::RngState state,
                 const T* input,
                 Index stride,
                 Index n_rows,
                 raft::device_matrix_view<T, Index> output)
{
  raft::matrix::detail::sample_rows(res, state, input, stride, n_rows, output);
}

}  // namespace cuvs::detail

