extern template void raft::sparse::linalg::detail::coo_degree<64, int, int, int>(int const*,
                                                                                 int,
                                                                                 int*,
                                                                                 cudaStream_t);

extern template void raft::sparse::linalg::detail::coo_degree<64, int, long, long>(int const*,
                                                                                   long,
                                                                                   long*,
                                                                                   cudaStream_t);

namespace cuvs::detail {

template <typename T, typename idx_t, typename nnz_t>
void coo_remove_scalar(const idx_t* rows,
                       const idx_t* cols,
                       const T* vals,
                       nnz_t nnz,
                       idx_t* crows,
                       idx_t* ccols,
                       T* cvals,
                       nnz_t* cnnz,
                       nnz_t* cur_cnnz,
                       T scalar,
                       idx_t n,
                       cudaStream_t stream)

{
  return raft::sparse::op::coo_remove_scalar(
    rows, cols, vals, nnz, crows, ccols, cvals, cnnz, cur_cnnz, scalar, n, stream);
}

template <typename T, typename idx_t, typename nnz_t>
void coo_remove_scalar(raft::sparse::COO<T, idx_t, nnz_t>* in,
                       raft::sparse::COO<T, idx_t, nnz_t>* out,
                       T scalar,
                       cudaStream_t stream)

{
  return raft::sparse::op::coo_remove_scalar(in, out, scalar, stream);
}

template <int TPB_X, typename T, typename idx_t, typename nnz_t>
void coo_remove_scalar(raft::resources const& handle,
                       raft::device_coo_matrix_view<const T, idx_t, idx_t, nnz_t> in,
                       raft::host_scalar_view<const T> scalar,
                       raft::device_coo_matrix<T, idx_t, idx_t, nnz_t>& out)

{
  return raft::sparse::op::coo_remove_scalar<TPB_X>(handle, in, scalar, out);
}

}  // namespace cuvs::detail

// clang-format off
template @return_type@ @qualified_function@@template_arguments@(@parameter_types@)@function_qualifiers@;
