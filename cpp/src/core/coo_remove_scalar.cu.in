                                                                         thrust::device_ptr<int>,
                                                                         thrust::device_ptr<int>,
                                                                         int,
                                                                         ::cuda::std::plus<void>>(
  thrust::cuda_cub::execution_policy<rmm::thrust_exec_policy_t>&,
  thrust::device_ptr<int>,
  thrust::device_ptr<int>,
  thrust::device_ptr<int>,
  int,
  ::cuda::std::plus<void>);

extern template thrust::device_ptr<long> thrust::cuda_cub::exclusive_scan<rmm::thrust_exec_policy_t,
                                                                          thrust::device_ptr<long>,
                                                                          thrust::device_ptr<long>,
                                                                          long,
