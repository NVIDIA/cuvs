namespace cuvs::detail {

template <typename T, typename Index>
void select_k(raft::resources const& handle,
              T const* values,
              Index const* indices,
              size_t rows,
              size_t columns,
              int k,
              T* selected_values,
              Index* selected_indices,
              bool select_min,
              bool sorted,
              raft::matrix::SelectAlgo algorithm,
              Index const* row_lengths)
{
  raft::matrix::detail::select_k<T, Index>(handle,
                                           values,
                                           indices,
                                           rows,
                                           columns,
                                           k,
                                           selected_values,
                                           selected_indices,
                                           select_min,
                                           sorted,
                                           algorithm,
                                           row_lengths);
}

