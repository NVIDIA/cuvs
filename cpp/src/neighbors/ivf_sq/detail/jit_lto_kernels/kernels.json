      "kernel_input": "accumulate_distance_kernel.cu.in",
      "fragment_tag_format": "@ivf_sq_ns@::fragment_tag_accumulate_distance<@ivf_sq_ns@::tag_metric_@metric_name@>",
      "fragment_tag_headers": [
        "<cuvs/detail/jit_lto/ivf_sq/scan_fragments.hpp>"
      ],
      "output_dir": "@CMAKE_CURRENT_BINARY_DIR@/generated_kernels/ivf_sq/accumulate_distance"
