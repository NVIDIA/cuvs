        "<cuvs/detail/jit_lto/ivf_sq/scan_fragments.hpp>",
        "<cuvs/detail/jit_lto/common_fragments.hpp>"
      ],
      "output_dir": "@CMAKE_CURRENT_BINARY_DIR@/generated_kernels/ivf_sq/scan"
    },
    {
      "name_format": "ivf_sq_setup_invariant_smem_metric_@metric_name@",
      "matrix": "setup_invariant_smem_matrix.json",
      "kernel_input": "setup_invariant_smem_kernel.cu.in",
