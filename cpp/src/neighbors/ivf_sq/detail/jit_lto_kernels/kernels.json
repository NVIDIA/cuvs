    {
      "name_format": "ivf_sq_filter_@filter_name@",
      "matrix": "filter_matrix.json",
      "kernel_input": "filter_kernel.cu.in",
      "fragment_tag_format": "@ivf_sq_ns@::fragment_tag_ivf_sq_filter<@neighbors_ns@::tag_filter_@filter_name@>",
