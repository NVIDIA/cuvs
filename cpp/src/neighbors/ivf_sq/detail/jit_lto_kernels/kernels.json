      "fragment_tag_headers": [
        "<cuvs/detail/jit_lto/ivf_sq/scan_fragments.hpp>"
      ],
      "output_dir": "@CMAKE_CURRENT_BINARY_DIR@/generated_kernels/ivf_sq/setup_invariant_smem"
    },
    {
      "name_format": "ivf_sq_setup_per_probe_smem_metric_@metric_name@",
      "matrix": "setup_per_probe_smem_matrix.json",
      "kernel_input": "setup_per_probe_smem_kernel.cu.in",
