      "fragment_tag_headers": [
        "<cuvs/detail/jit_lto/ivf_sq/scan_fragments.hpp>"
      ],
      "output_dir": "@CMAKE_CURRENT_BINARY_DIR@/generated_kernels/ivf_sq/setup_per_probe_smem"
    },
    {
      "name_format": "ivf_sq_accumulate_distance_metric_@metric_name@",
