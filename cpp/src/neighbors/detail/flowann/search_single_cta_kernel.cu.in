#include <neighbors/detail/flowann/kernel.cuh>
#include <neighbors/detail/flowann/search_single_cta_jit.cuh>

#include <type_traits>

namespace {

constexpr bool k_topk_by_bitonic_sort               = @topk_by_bitonic_sort@;
constexpr bool k_bitonic_sort_and_merge_multi_warps = @bitonic_sort_and_merge_multi_warps@;

using data_t         = @data_type@;
using index_t        = @index_type@;
using distance_t     = @distance_type@;
using source_index_t = @source_index_type@;
using dataset_desc_base =
  cuvs::neighbors::cagra::detail::dataset_descriptor_base_t<data_t, index_t, distance_t>;
using filter_payload_t = cuvs::neighbors::cagra::detail::cagra_sample_filter<source_index_t>;
using queue_view       = cuvs::neighbors::cagra::experimental::flowann::detail::queue_view;

}  // namespace

namespace cuvs::neighbors::cagra::experimental::flowann::detail {

extern "C" __global__ __launch_bounds__(1024, 1) void flowann_search_single_cta(
  uintptr_t result_indices,
  distance_t* distances,
  std::uint32_t top_k,
  const data_t* queries,
  const std::uint8_t* inner_graph,
  std::uint32_t inner_row_length,
  std::uint32_t node_per_cacheline,
  std::uint32_t n_bits,
  const std::uint32_t* subgraph_offsets,
  const std::uint32_t* subgraph_ids,
  queue_view* queues,
  std::uint32_t num_queues,
  std::uint32_t graph_degree,
  std::uint32_t cross_graph_degree,
  const source_index_t* source_indices,
  unsigned num_distillation,
  std::uint64_t rand_xor_mask,
  const index_t* seeds,
  std::uint32_t num_seeds,
  const std::uint32_t* seed_cross_graph,
  const index_t* seed_lookup_keys,
  const std::uint32_t* seed_lookup_values,
  std::uint32_t seed_lookup_capacity,
  index_t* visited_hashmap,
  std::uint32_t max_candidates,
  std::uint32_t max_itopk,
  std::uint32_t internal_topk,
  std::uint32_t search_width,
  std::uint32_t min_iterations,
  std::uint32_t max_iterations,
  std::uint32_t* num_executed_iterations,
  std::uint32_t hash_bitlen,
  std::uint32_t small_hash_bitlen,
  std::uint32_t small_hash_reset_interval,
  std::uint32_t query_id_offset,
  const dataset_desc_base* dataset_desc,
  index_t graph_size,
  float sync_window_scale,
  std::uint32_t sync_drop_threshold,
  filter_payload_t filter_payload)
{
  search_kernel_jit<k_topk_by_bitonic_sort,
                    k_bitonic_sort_and_merge_multi_warps,
                    data_t,
                    index_t,
                    distance_t,
                    source_index_t>(result_indices,
                                    distances,
                                    top_k,
                                    queries,
                                    inner_graph,
                                    inner_row_length,
                                    node_per_cacheline,
                                    n_bits,
                                    subgraph_offsets,
                                    subgraph_ids,
                                    queues,
                                    num_queues,
                                    graph_degree,
                                    cross_graph_degree,
                                    source_indices,
                                    num_distillation,
                                    rand_xor_mask,
                                    seeds,
                                    num_seeds,
                                    seed_cross_graph,
                                    seed_lookup_keys,
                                    seed_lookup_values,
                                    seed_lookup_capacity,
                                    visited_hashmap,
                                    max_candidates,
                                    max_itopk,
                                    internal_topk,
                                    search_width,
                                    min_iterations,
                                    max_iterations,
                                    num_executed_iterations,
                                    hash_bitlen,
                                    small_hash_bitlen,
                                    small_hash_reset_interval,
                                    query_id_offset,
                                    dataset_desc,
                                    graph_size,
                                    sync_window_scale,
                                    sync_drop_threshold,
                                    filter_payload);
}

static_assert(
  std::is_same_v<decltype(flowann_search_single_cta),
                 search_single_cta_kernel_func_t<data_t, index_t, distance_t, source_index_t>>);

}  // namespace cuvs::neighbors::cagra::experimental::flowann::detail
