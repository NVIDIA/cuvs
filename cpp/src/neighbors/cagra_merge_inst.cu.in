#include <cuvs/core/cuda_fp16.hpp>

#include <cuvs/neighbors/cagra.hpp>
#include <neighbors/cagra.cuh>

namespace {

using data_t                    = @data_type@;
using index_t                   = @index_type@;
using inst_device_padded_view_t = cuvs::neighbors::device_padded_dataset_view<data_t, int64_t>;

}  // namespace

namespace cuvs::neighbors::cagra {

using inst_device_standard_view_t = cuvs::neighbors::device_standard_dataset_view<data_t, int64_t>;

extern template void index<data_t, index_t, inst_device_padded_view_t>::compute_dataset_norms_(
  raft::resources const&);
extern template void index<data_t, index_t, inst_device_standard_view_t>::compute_dataset_norms_(
  raft::resources const&);

#define CUVS_INST_CAGRA_MERGE(DatasetViewT)                                                \
  template CUVS_EXPORT int64_t detail::merged_dataset_size<data_t, index_t, DatasetViewT>( \
    raft::resources const& handle,                                                         \
    std::vector<index<data_t, index_t, DatasetViewT>*> const& indices,                     \
    cuvs::neighbors::filtering::base_filter const& row_filter);                            \
                                                                                           \
  auto merge(raft::resources const& res,                                                   \
             const index_params& params,                                                   \
             std::vector<index<data_t, index_t, DatasetViewT>*>& indices,                  \
             DatasetViewT merged_dataset,                                                  \
             const cuvs::neighbors::cagra::merge_params& merge_params,                     \
             const cuvs::neighbors::filtering::base_filter& row_filter)                    \
    -> index<data_t, index_t, DatasetViewT>                                                \
  {                                                                                        \
    return cuvs::neighbors::cagra::merge<data_t, index_t, DatasetViewT>(                   \
      res, params, indices, merged_dataset, merge_params, row_filter);                     \
  }

CUVS_INST_CAGRA_MERGE(inst_device_padded_view_t);
CUVS_INST_CAGRA_MERGE(inst_device_standard_view_t);

#undef CUVS_INST_CAGRA_MERGE

}  // namespace cuvs::neighbors::cagra
