#include <cluster/detail/kmeans_mg.cuh>

#include <cuvs/cluster/kmeans.hpp>
#include <raft/core/host_mdspan.hpp>
#include <raft/core/resources.hpp>

#include <optional>
#include <vector>

namespace {

using data_t = @data_type@;

}  // namespace

// Multi-GPU k-means fit overloads that take several local partitions per rank.
// The single-partition overloads generated from kmeans_fit_inst.cu.in dispatch
// to the multi-GPU backend based on the resources attached to the handle.
namespace cuvs::cluster::kmeans {

#define CUVS_INST_KMEANS_FIT_MG(MatrixViewT, VectorViewT, IndexT)                             \
  void fit(                                                                                   \
    raft::resources const& handle,                                                            \
    const cuvs::cluster::kmeans::params& params,                                              \
    const std::vector<MatrixViewT<const data_t, IndexT>>& X_parts,                            \
    const std::optional<std::vector<VectorViewT<const data_t, IndexT>>>& sample_weight_parts, \
    raft::device_matrix_view<data_t, IndexT> centroids,                                       \
    raft::host_scalar_view<data_t> inertia,                                                   \
    raft::host_scalar_view<IndexT> n_iter)                                                    \
  {                                                                                           \
    cuvs::cluster::kmeans::mg::detail::mnmg_fit<data_t, IndexT>(                              \
      handle, params, X_parts, sample_weight_parts, centroids, inertia, n_iter);              \
  }

CUVS_INST_KMEANS_FIT_MG(raft::device_matrix_view, raft::device_vector_view, int)
CUVS_INST_KMEANS_FIT_MG(raft::device_matrix_view, raft::device_vector_view, int64_t)
CUVS_INST_KMEANS_FIT_MG(raft::host_matrix_view, raft::host_vector_view, int64_t)

#undef CUVS_INST_KMEANS_FIT_MG

}  // namespace cuvs::cluster::kmeans
